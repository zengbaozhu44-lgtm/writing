  "diffLines": [
    {
      "type": "change",
      "before": "林砚的手指插进样本核心的散热槽，金属边缘割开虎口，血顺着腕骨淌进袖口。他没管。解析进度条在视网膜上烧成一条白线，最后百分之三走得比一个世纪还长。",
      "after": "林砚的手指插进样本核心的散热槽，金属边林砚的指腹按在样本核心的裂纹上，那道裂口正以肉眼可见的速度愈合。他咬破舌尖，把血滴进去——加密层像被烫伤一样剥开，露出一行字。",
      "index": 30
    },
    {
      "type": "change",
      "before": "屏幕亮了。",
      "after": "「请协助我们保卫现实，我们愿提供资源支持。」",
      "index": 32
    },
    {
      "type": "change",
      "before": "密信只有一句话，落款是玩家世界政府的最高权限印鉴。他盯着那行字，喉咙里涌上一股酸腥——保卫现实？他们连自己头顶那片天都管不住。",
      "after": "他盯着那行字，喉咙发紧。底下附着一张照片：一座他认得的城市，高楼、霓虹、街道，全是他从青穹重工监控屏上看了十年的布局。而城市上空，悬浮着一艘浮空战舰，舰首的青穹徽记在阳光下反着冷光。",
      "index": 34
