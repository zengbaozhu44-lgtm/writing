  "diffLines": [
    {
      "type": "change",
      "before": "“操。”林砚把额头抵在屏幕上，金属边框冰得他眼眶发酸。他想起林薇最后那条语音——她说哥，别怕。可他怕得要死，手抖得点不中那个小得可怜的确认",
      "after": "“操。”林砚把额头抵在屏幕上，金属边框冰得他眼眶发酸。他想起林薇最后那条语音——她说哥，别怕。可他怕得要死，手抖得点不中指尖砸下回车的那一刻，林砚左手小指像被烧透的线扯断一样猛地抽搐。他没管，眼睛死死钉在屏幕上。",
      "index": 18
    },
    {
      "type": "change",
      "before": "指尖在回车键上砸下去的时候，林砚整个左手的小指猛地抽搐了一下——像被什么东西从里面拽断了。他低头，指尖已经焦成灰白，指甲盖翘起一半，疼得他后槽牙咬出了一声闷响。",
      "after": "管理员验证条推满，弹出那行字——玩家林薇，ID已锁定，实时坐标提取中。他盯着“林薇”两个字，喉咙里翻涌着酸涩，右手却已经在键盘上炸开，一行行命令从他指缝里倾泻而出。",
      "index": 20
    },
    {
      "type": "change",
      "before": "他骂了一句：“操。”",
      "after": "监控屏右下角跳出一行灰字：权限锁已剥离，前置提取通道将于十一秒后自毁。他没停顿，把完好的右手按上读取器，焦毁的左肩撞在桌沿上，疼痛从脊柱一路窜到后脑勺。他咬着牙，把最后一行代码敲上去——那是他在林薇留下的残骸数据里，扒出来的执法者护盾频率漏洞。",
      "index": 22
    },
    {
      "type": "change",
      "before": "屏幕上，管理员的验证条缓缓推满，弹出一行字：玩家林薇，ID 已锁定，实时坐标提取中。",
      "after": "“沈寒舟。”他对着耳麦开口，声音哑得折了半截，“帮我拖住渊尊，十秒就够。”",
      "index": 24
    },
    {
      "type": "change",
      "before": "他瞪着那行字，耳鸣嗡嗡的，右手指尖不受控地抖，指尖在桌沿上蹭了两下，蹭掉一层",
      "after": "对面沉默了两拍，然后是一声轻笑，像刀鞘磕在石头棱上：“行，你欠我一次。”",
      "index": 26
    },
    {
      "type": "change",
      "before": "管理员权限刷开后台的瞬间，监控屏上弹出一行红字——「前置任务：完成度99.7%」。林砚的指节压在键盘上，发白的指腹硌得生疼。他屏住呼吸，等着最后的0.3%跳满。",
      "after": "十一秒，像过完一整年。",
      "index": 28
    },
    {
      "type": "change",
      "before": "屏幕却切了画面。",
      "after": "数据流从他指尖喷涌而出，战场全息投影上，每个玩家的属性栏都在跳动着陌生的金色数值。他听见战场频道里炸开一片惊呼，有人喊“护盾破了”，有人喊“召唤阵亮了”，有人喊的是他名字，带着哭腔。",
      "index": 30
    },
    {
      "type": "change",
      "before": "林薇的脸出现在监控里，嘴角挂着笑，正对镜头比了个“嘘”的手势。他喉咙发紧，耳边嗡鸣。“别找了，”她轻声说，“前置的钥匙，在我这儿。”",
      "after": "他靠在椅背上，后背的汗把衣服浸透。屏幕上的战场正以肉眼可见的速度逆转——玩家像疯了一样往执法者的阵型里撞，配合着召唤阵里涌出的强化光芒，把机械执法者的阵线撕成碎片。",
      "index": 32
    },
    {
      "type": "change",
      "before": "他猛地攥紧拳头，指甲陷",
      "after": "他应该笑，应该松口气。可他的视线始终钉在监控屏那个已经黑掉的角落——林薇消失前站过的地方。",
      "index": 34
    },
    {
      "type": "change",
      "before": "监控屏右下角弹出一行灰字：权限锁已剥离，前置提取通道将于十一秒后自毁。林砚把完好的右手按上读取器，焦毁的左肩撞在桌沿，一阵抽搐从脊柱窜到后脑勺。他没骂，只是把牙咬得咯吱响。",
      "after": "耳麦里传来沈寒舟的声音，带着喘：“搞定了？”",
      "index": 36
    },
    {
      "type": "change",
      "before": "“沈寒舟。”他对着耳麦说，声音折在半截，“帮我拖住渊尊，十秒就够。”",
      "after": "“嗯。”他说，然后顿了顿，“沈寒舟，林薇她……”",
      "index": 38
    },
    {
      "type": "change",
      "before": "对面沉默了两拍。然后是一声轻笑，像刀鞘磕在石头上：“行，你欠我一次。”",
      "after": "话音没落，监控屏突然从中间裂开一道缝，一缕暗红色的光从裂缝里渗出来。他猛地坐直，瞳孔骤缩。",
      "index": 40
    },
    {
      "type": "change",
      "before": "屏幕",
      "after": "屏幕裂口里，缓缓浮起一行字，笔迹是林薇的——",
      "index": 42
    },
    {
      "type": "add",
      "before": "",
      "after": "“哥，别急着关。我还没死透。”",
      "index": 44
    }
